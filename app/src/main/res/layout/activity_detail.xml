<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipChildren="false">

    <!-- Right-side full-bleed cinematic backdrop -->
    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="42dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="16dp">

        <!-- Left Metadata & Vertical Action Stack (Netflix TV style) -->
        <LinearLayout
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="VIETMOVIE  •  CHI TIẾT PHIM"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Vertical Action Buttons (Like Netflix TV Screenshot 2) -->
            <Button
                android:id="@+id/btnPlayNow"
                android:layout_width="290dp"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_netflix_play_btn"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="▶   Xem ngay"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChooseServer"
                android:layout_width="290dp"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_netflix_secondary_btn"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Đang tìm bản Thuyết Minh..."
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Episodes Section -->
        <TextView
            android:id="@+id/tvEpisodeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="Danh sách tập"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpisodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="4dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>

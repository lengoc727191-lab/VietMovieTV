<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipChildren="false">

    <!-- Dynamic Netflix-style Backdrop synced with focused movie -->
    <ImageView
        android:id="@+id/ivHomeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <!-- Row 1: Brand + Category Pills + Source + Search -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:letterSpacing="0.06"
                android:text="VIETMOVIE"
                android:textColor="@color/netflix_red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp">

                    <Button
                        android:id="@+id/tabNew"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Mới nhất"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/tabPopular"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Xem nhiều"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_amber"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabDubbed"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Thuyết Minh"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/tabSeries"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Phim Bộ"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/tabSingle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Phim Lẻ"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/tabAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="Hoạt Hình"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/tabTvShows"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="TV Shows"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnSource"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Nguồn: Tự động"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tìm kiếm"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Inline Instant Search Bar (Live results as you type!) -->
        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Gõ tên phim để tự động hiện kết quả ngay..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnCloseSearch"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Đóng"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 3: Country & Genre Filter Bar (Works across ALL tabs!) + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/btnFilterCountry"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Quốc gia: Tất cả ▾"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterGenre"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Thể loại: Tất cả ▾"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnResetFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tab_selector"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="✕ Xóa lọc"
                android:textAllCaps="false"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="Đang tải danh sách phim..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Content Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovies"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="16dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VietMovieTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/netflix_red</item>
        <item name="colorAccent">@color/netflix_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/Theme.VietMovieTV.Dialog</item>
    </style>

    <style name="Theme.VietMovieTV.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="colorAccent">@color/netflix_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
